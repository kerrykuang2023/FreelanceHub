{
  "compilerOptions": {
    "target": "es2016",                                 
    "module": "commonjs",                               
    "outDir": "./dist",                
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "baseUrl": ".",
    "noImplicitAny": false
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "src/tests/**/*"]
}
