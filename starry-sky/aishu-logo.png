<unified-nav-main></unified-nav-main>  <style>
.error-tips-page {
    padding: 160px 0;
}

.box {
    box-shadow: 0 0 3px 2px #e3e3e3;
    padding: 6% 5%;
    max-width: 800px;
    box-sizing: border-box;

}

.error-tips-page .img,
.error-tips-page .text {
    display: inline-block;
    vertical-align: middle;
    box-sizing: border-box;
    max-width: 49%;
}

.error-tips-page .text {
    padding-left: 4%;

}

.img .code {
    background: #454e68;
    color: #fff;
    font-size: 70px;
    padding: 0 20px;
    border-radius: 5px;
    display: inline-block;
    line-height: 86px;
}

.img .explain {
    font-size: 24px;
    text-align: center;
    font-weight: 600;
    border-top: 2px solid #454e68;
    margin-top: 10px;
    padding-top: 6px;
}

.error-tips-page .links {
    text-align: right;
    margin-top: 40px;

}

.error-tips-page .links .m-btn-3 {
    padding: 0 30px;
    margin: 0 10px
}

.error-tips-page .links .seconds {
    color: #c80000;
}

.redirect {
    text-align: center;
    margin-top: 32px;
    font-size: 18px;
}

.redirect .time {
    padding: 0 6px;
    text-decoration: underline;
}

@media  screen and (max-width:768px) {
    .error-tips-page .box {
        padding: 1.6rem 0;

        .box {
            .links {

                .m-btn-3,
                .m-btn-1 {
                    margin: 0.1333rem 0.2667rem;
                }
            }
        }

    }
}
</style>
<div class="error-tips-page t-b-pad2 j-set-white-nav">
    <div class="box wid1000">
        <div class="img">
            <span class="code">404</span>
            <p class="explain">NOT FOUND</p>
        </div>
        <div class="text">
            <h3 class="til">抱歉！页面无法访问！</h3>
            <b>可能原因：</b>
            <p>· 网络信号弱</p>
            <p>· 网址已失效</p>
            <p>· 输入的网址有误</p>
        </div>

        <div class="links">
            <a class="m-btn-3 act-open-contact-window" href="javascript:void(0)">联系我们</a>
            <a class="m-btn-4" href="/">返回</a>
        </div>
    </div>
    <p class="redirect">倒计时<span class="time">3</span>秒，为您跳转爱数首页...</p>
</div>
<script>
window.onload = function() {
    let timeSpan = document.querySelector('.redirect .time'),
        count = parseInt(timeSpan.innerText);
    const timer = setInterval(function() {
        if (count == 0) {
            clearInterval(timer);
            location.href = '/'
        } else {
            count--;
            timeSpan.innerText = count;
        }
    }, 1000);
}
</script>
